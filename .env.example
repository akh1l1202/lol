# Copy to backend/.env and fill in. backend/.env is gitignored.

# Postgres connection. Leave unset to run with the in-memory user store.
# The schema is created automatically on startup (CREATE TABLE IF NOT EXISTS),
# so any empty Postgres database works with no manual setup.
#
# Local Homebrew Postgres (default):
DATABASE_URL=postgres://localhost:5432/nudge?sslmode=disable
#
# Hosted Postgres (Supabase / Neon) — use the direct/session connection string
# and require SSL. Keep your Go JWT auth; this only changes where the data lives.
# Supabase: Project Settings -> Database -> Connection string -> URI (port 5432).
# DATABASE_URL=postgres://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres?sslmode=require

# JWT signing secret. Use a long random string in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port (default 8080).
PORT=8080
